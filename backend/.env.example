# 复制为 backend/.env 后按本机修改（此文件可提交仓库）
SATELLITE_DATABASE_HOST=localhost
SATELLITE_DATABASE_PORT=5432
SATELLITE_DATABASE_USER=satellite_user
SATELLITE_DATABASE_PASSWORD=CHANGE_ME
SATELLITE_DATABASE_DBNAME=satellite_db
SATELLITE_DATABASE_SSLMODE=disable

# 遥感模块
# Windows 本地请将 PYTHON 指向 wsl-python.cmd.example 复制后的 wsl-python.cmd
SATELLITE_REMOTE_SENSING_ROOT=../Satellite-Remote-Sensing
SATELLITE_REMOTE_SENSING_PYTHON=
SATELLITE_REMOTE_SENSING_DEM_FILE=
SATELLITE_REMOTE_SENSING_DEVICE=cpu

# 目标检测（串行流水线第 10 阶段；Linux/K8s 直接填二进制路径，无需 wsl-*.cmd）
SATELLITE_OBJECT_DETECTION_ROOT=../Object-Detection
# Windows 本地：复制 wsl-detection.cmd.example 为 wsl-detection.cmd 并填写绝对路径
# SATELLITE_OBJECT_DETECTION_RUNNER=D:/Code/pcl_satellite_project/satellite-cloud/backend/wsl-detection.cmd
# Linux/K8s 留空即可，后端自动使用 {ROOT}/yolov8s
SATELLITE_OBJECT_DETECTION_RUNNER=
SATELLITE_OBJECT_DETECTION_DEVICE=cpu
SATELLITE_OBJECT_DETECTION_STAGE_TIMEOUT_SECONDS=14400
SATELLITE_OBJECT_DETECTION_OUTPUT_SUBDIR=output_detection
#
# Object-Detection 构建（WSL，首次或升级后）：
#   bash scripts/fetch_font.sh && go build -o yolov8s .
# 详见 Object-Detection/K8S_RUNTIME_PREP.md
